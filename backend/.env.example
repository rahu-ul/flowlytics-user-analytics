# Copy to .env (never commit .env)
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=causalfunnel_analytics
# Optional comma-separated DNS servers used before the MongoDB Atlas SRV lookup.
# MONGODB_DNS_SERVERS=8.8.8.8,8.8.4.4
# Comma-separated origins allowed to call the read API from a browser (dashboard dev server).
DASHBOARD_ORIGINS=http://localhost:5173
# Per-IP requests/minute allowed on POST /api/events
INGEST_RATE_LIMIT_PER_MIN=600
# Set to 1 when running behind one reverse proxy (Render, Railway, Nginx) so rate limiting sees client IPs
# TRUST_PROXY=1

# Max simultaneous dashboard Socket.IO connections (default 200). The socket endpoint has no authentication.
# REALTIME_MAX_CLIENTS=200
